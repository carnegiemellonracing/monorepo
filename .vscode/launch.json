{
    "version": "0.2.0",

    "configurations": [
        {
            "name": "Build & Debug (CMake target) - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "launch",

            "preLaunchTask": "Build project",

            "executable": "${command:cmake.buildDirectory}/${command:cmake.buildTargetName}/src/${command:cmake.buildTargetName}-build/${command:cmake.buildTargetName}.elf",

            "servertype": "stlink",
            "device": "STM32F413RGTx",
            "interface": "swd",
            "serialNumber": "",
            "runToEntryPoint": "main",

            "svdFile": "${config:STM32VSCodeExtension.cubeCLT.path}/STMicroelectronics_CMSIS_SVD/STM32F413.svd",
            "v1": false,
            "serverpath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${config:STM32VSCodeExtension.cubeCLT.path}/STM32CubeProgrammer/bin",
            "stlinkPath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "armToolchainPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "serverArgs": ["-m", "0"]
        },

        {
            "name": "Attach (CMake target) - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "attach",

            "executable": "${command:cmake.buildDirectory}/${command:cmake.buildTargetName}/src/${command:cmake.buildTargetName}-build/${command:cmake.buildTargetName}.elf",

            "servertype": "stlink",
            "device": "STM32F413RGTx",
            "interface": "swd",
            "serialNumber": "",

            "svdFile": "${config:STM32VSCodeExtension.cubeCLT.path}/STMicroelectronics_CMSIS_SVD/STM32F413.svd",
            "v1": false,
            "serverpath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${config:STM32VSCodeExtension.cubeCLT.path}/STM32CubeProgrammer/bin",
            "stlinkPath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "armToolchainPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "serverArgs": ["-m", "0"]
        },

        {
            "name": "Build & Debug DCM (H725) - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "launch",

            "preLaunchTask": "Build DCM",

            "executable": "${command:cmake.buildDirectory}/DCM/src/DCM-build/DCM.elf",

            "servertype": "stlink",
            "device": "STM32H725ZGTx",
            "interface": "swd",
            "serialNumber": "",
            "runToEntryPoint": "main",

            "svdFile": "${config:STM32VSCodeExtension.cubeCLT.path}/STMicroelectronics_CMSIS_SVD/STM32H725.svd",
            "v1": false,
            "serverpath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${config:STM32VSCodeExtension.cubeCLT.path}/STM32CubeProgrammer/bin",
            "stlinkPath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "armToolchainPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "serverArgs": ["-m", "0"]
        },

        {
            "name": "Attach to DCM (H725) - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "attach",

            "executable": "${command:cmake.buildDirectory}/DCM/src/DCM-build/DCM.elf",

            "servertype": "stlink",
            "device": "STM32H725ZGTx",
            "interface": "swd",
            "serialNumber": "",

            "svdFile": "${config:STM32VSCodeExtension.cubeCLT.path}/STMicroelectronics_CMSIS_SVD/STM32H725.svd",
            "v1": false,
            "serverpath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${config:STM32VSCodeExtension.cubeCLT.path}/STM32CubeProgrammer/bin",
            "stlinkPath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "armToolchainPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "serverArgs": ["-m", "0"]
        }
    ]
}