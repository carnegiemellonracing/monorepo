FormatVersion=5.0 // Do not edit this line!
Title="25e_combined"

{ENUMS}
enum VtSig_VSM_state(0="UNKNOWN", 1="GLV_ON", 2="HV_EN", 3="RTD", 4="ERROR", 
  5="CLEAR_ERROR")
enum VtSig_VSM_internalState(0="ERROR", 1="CLEAR_ERROR", 2="GLV_ON", 
  3="REQ_PRECHARGE", 4="RUN_BMS", 5="DCDC_EN", 6="INVERTER_EN", 7="HV_EN", 
  8="RTD", 9="COOLING_OFF", 10="DCDC_OFF")
enum VtSig_HVC_Mode(0="ERROR", 1="IDLE", 2="START", 4="RUN", 8="CHARGE")
enum VtSig_HVC_State(0="ERROR", 1="DISCHARGE", 2="STANDBY", 
  3="DRIVE_PRECHARGE", 4="DRIVE_PRECHARGE_COMPLETE", 5="DRIVE", 
  6="CHARGE_PRECHARGE", 7="CHARGE_PRECHARGE_COMPLETE", 8="CHARGE_TRICKLE", 
  9="CHARGE_CONSTANT_CURRENT", 10="CHARGE_CONSTANT_VOLTAGE", 11="CLEAR_ERROR", 
  12="UNKNOWN")
enum VtSig_DIM_requestGear(0="UNKNOWN", 1="SLOW", 2="FAST", 3="ENDURANCE", 
  4="AUTO-X", 5="SKIDPAD", 6="ACCEL", 7="TEST", 8="REVERSE")
enum VtSig_DIM_requestDRSMode(0="DRS_CLOSED", 1="DRS_OPEN", 2="DRS_TOGGLE", 
  3="DRS_HOLD", 4="DRS_AUTO", 5="DRS_UNKNOWN")
enum VtSig_SBG_Solution_Mode(0="Uninitialized", 1="Vertical_Gyro_Only", 
  2="Orientation_Only", 3="Nav_Velocity", 4="Full_Nav")
enum VtSig_EMD_CurrentGain(0="x1", 1="x2", 2="x4", 3="x8", 4="x16", 5="x32")
enum VtSig_CCM_state(0="ERROR", 1="CLEAR_ERROR", 2="CLEAR_HVC", 3="IDLE_HVC", 
  4="STANDBY", 5="CHARGE_REQ", 6="CHARGE", 7="SLOW_CHARGE", 8="SHUTDOWN")
enum VtSig_Enable(0="BALANCE_DIS", 1="BALANCE_EN")
enum VtSig_Movella_fitler_mode(
  0="Without GNSS (filter profile is in VRU mode)", 
  1="Coasting mode (GNSS has been lost <60 sec ago)", 
  3="With GNSS (default mode)")
enum VtSig_Actual_FaultCode_FL(0="NO_FAULT", 
  1="OVERVOLTAGE_-The_input_voltage_is_higher_than_the_set_maximum", 
  2="UNDERVOLTAGE-The_input_voltage_is_lower_than_the_set_minimum", 
  3="DRV_ERROR-Transistor_or_transistor_drive_error", 
  4="ABSOLUTE_MAX_OVERCURRENT-The_AC_current_is_higher_than_the_set_absolute_maximum_current", 
  5="CONTROLLER_OVERTEMPERATURE-The_controller_temperature_is_higher_than_the_set_maximum", 
  6="MOTOR_OVERTEMPERATURE-The_motor_temperature_is_higher_than_the_set_maximum", 
  7="SENSOR_WIRE_FAULT-Something_went_wrong_with_the_sensor_differential_signals", 
  8="SENSOR_GENERAL_FAULT-An_error_occurred_while_processing_the_sensor_signals", 
  9="CAN_COMMAND_ERROR-CAN_message_received_contains_parameter_out_of_boundaries", 
  10="ANALOG_INPUT_ERROR�_Redundant_output_out_of_range")
enum VtSig_Digital_input_1_FL(0="Input_1_disabled", 1="Input_1_enabled")
enum VtSig_Digital_input_2_FL(0="Input_2_enabled", 1="Input_2_enabled")
enum VtSig_Digital_input_3_FL(0="Input_3_disabled", 1="Input_3_enabled")
enum VtSig_Digital_input_4_FL(0="Input_4_disabled", 1="Input_4_enabled")
enum VtSig_Digital_output_1_FL(0="Output_1_disabled", 1="Output_1_enabled")
enum VtSig_Digital_output_2_FL(0="Output_2_disabled", 1="Output_2_enabled")
enum VtSig_Digital_output_3_FL(0="Output_3_disabled", 1="Output_3_enabled")
enum VtSig_Digital_output_4_FL(0="Output_4_disabled", 1="Output_4_enabled")
enum VtSig_Drive_enable_FL(0="Drive_disabled", 1="Drive_enabled")
enum VtSig_Capacitor_temp_limit_FL(0="Capacitor_temperature_limit_inactive", 
  1="Capacitor_temperature_limit_active")
enum VtSig_DC_current_limit_FL(1="DC_current_limit_active", 
  0="DC_current_limit_inactive")
enum VtSig_Drive_enable_limit_FL(0="Drive_enable_limit_inactive", 
  1="Drive_enable_limit_active")
enum VtSig_IGBT_accel_limit_FL(
  0="IGBT_acceleration_temperature_limit_inactive", 
  1="IGBT_acceleration_temperature_limit_inactive")
enum VtSig_IGBT_temp_limit_FL(0="IGBT_temperature_limit_inactive", 
  1="IGBT_temperature_limit_active")
enum VtSig_Input_voltage_limit_FL(0="Input_voltage_limit_inactive", 
  1="Input_voltage_limit_active")
enum VtSig_Motor_accel_limit_FL(
  0="Motor_acceleration_temperature_limit_inactive", 
  1="Motor_acceleration_temperature_limit_active")
enum VtSig_Motor_temp_limit_FL(0="Motor_temperature_limit_inactive", 
  1="Motor_temperature_limit_active")
enum VtSig_RPM_min_limit_FL(0="RPM_minimum_limit_inactive", 
  1="RPM_minimum_limit_active")
enum VtSig_RPM_max_limit_FL(0="RPM_maximum_limit_inactive", 
  1="RPM_maximum_limit_active")
enum VtSig_Power_limit_FL(0="Power_limit_inactive", 1="Power_limit_active")
enum VtSig_CMD_DriveEnable_FL(1="Drive allowed", 0="Drive_not_allowed")

{SENDRECEIVE}

