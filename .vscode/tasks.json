{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "cmd.exe",
                "args": ["/d", "/c"]
            }
        }
    },
    "tasks": [
        {
            "type": "cmake",
            "label": "Build project",
            "command": "build",
            "targets": [
                "${command:cmake.buildTargetName}"
            ],
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build the CMake target selected in the status bar"
        },

        {
            "type": "cmake",
            "label": "Build DCM",
            "command": "build",
            "targets": ["DCM"],
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Build the DCM target"
        },

        {
            "type": "cmake",
            "label": "CMake: clean rebuild",
            "command": "cleanRebuild",
            "targets": ["all"],
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "CMake template clean rebuild task"
        },

        {
            "type": "shell",
            "label": "CubeProg: Flash project (SWD)",
            "command": "STM32_Programmer_CLI",
            "args": [
                "--connect",
                "port=swd",
                "--download",
                "${command:cmake.buildDirectory}/${command:cmake.buildTargetName}/src/${command:cmake.buildTargetName}-build/${command:cmake.buildTargetName}.elf",
                "-hardRst",
                "-rst",
                "--start"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },

        {
            "label": "Build + Flash",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build project",
                "CubeProg: Flash project (SWD)"
            ],
            "problemMatcher": []
        },

        {
            "type": "shell",
            "label": "CubeProg: List all available communication interfaces",
            "command": "STM32_Programmer_CLI",
            "args": ["--list"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}