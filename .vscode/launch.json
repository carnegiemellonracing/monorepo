{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // Four generic ST-Link configurations, in two logical pairs:
    //
    //   * "(CMake target)" - uses whatever target is selected in the CMake Tools
    //                        status bar (Build: [target]). No prompt.
    //   * "(pick project)" - prompts with a dropdown of the CMake projects.
    //
    // Both pairs assume an STM32F413RGTx. DCM is an H725, so it keeps its own two
    // configurations below until it moves to the F413.
    //
    // The ELF path comes straight from CMake:
    //   <cmake build dir>/<TARGET>/src/<TARGET>-build/<TARGET>.elf
    // ${command:cmake.buildDirectory} follows the active preset, so build/debug vs
    // build/static needs no edits here.
    "version": "0.2.0",
    "inputs": [
        {
            "id": "cmakeProject",
            "type": "pickString",
            "description": "Which CMake project do you want to debug?",
            "options": [
                "DIM",
                "HV-BMS",
                "HVC",
                "LV-BMS",
                "RAM",
                "VSM"
            ]
        }
    ],
    "configurations": [
        // ============================================================================
        //             Selected CMake target (status bar) - STM32F413RGTx
        // ============================================================================
        {
            "name": "Build & Debug (CMake target) - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "launch",
            "preLaunchTask": "Build project",
            "executable": "${command:cmake.buildDirectory}/${command:cmake.buildTargetName}/src/${command:cmake.buildTargetName}-build/${command:cmake.buildTargetName}.elf",
            "servertype": "stlink",
            "device": "STM32F413RGTx", //MCU used
            "interface": "swd",
            "serialNumber": "",        //Set ST-Link ID if you use multiple at the same time
            "runToEntryPoint": "main",
            "svdFile": "${config:STM32VSCodeExtension.cubeCLT.path}/STMicroelectronics_CMSIS_SVD/STM32F413.svd",
            "v1": false,               //Change it depending on ST Link version
            "serverpath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${config:STM32VSCodeExtension.cubeCLT.path}/STM32CubeProgrammer/bin",
            "stlinkPath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "armToolchainPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "serverArgs": ["-m", "0"]
            /* If you use an external loader, add additional arguments */
            //"serverArgs": ["--extload", "path/to/ext/loader.stldr"],
        },
        {
            "name": "Attach (CMake target) - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "attach",
            "executable": "${command:cmake.buildDirectory}/${command:cmake.buildTargetName}/src/${command:cmake.buildTargetName}-build/${command:cmake.buildTargetName}.elf",
            "servertype": "stlink",
            "device": "STM32F413RGTx",
            "interface": "swd",
            "serialNumber": "",
            "svdFile": "${config:STM32VSCodeExtension.cubeCLT.path}/STMicroelectronics_CMSIS_SVD/STM32F413.svd",
            "v1": false,
            "serverpath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${config:STM32VSCodeExtension.cubeCLT.path}/STM32CubeProgrammer/bin",
            "stlinkPath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "armToolchainPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "serverArgs": ["-m", "0"]
        },

        // ============================================================================
        //                    Pick a CMake project - STM32F413RGTx
        // ============================================================================
        {
            "name": "Build & Debug (pick project) - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "launch",
            "preLaunchTask": "Build picked project",
            "executable": "${command:cmake.buildDirectory}/${input:cmakeProject}/src/${input:cmakeProject}-build/${input:cmakeProject}.elf",
            "servertype": "stlink",
            "device": "STM32F413RGTx",
            "interface": "swd",
            "serialNumber": "",
            "runToEntryPoint": "main",
            "svdFile": "${config:STM32VSCodeExtension.cubeCLT.path}/STMicroelectronics_CMSIS_SVD/STM32F413.svd",
            "v1": false,
            "serverpath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${config:STM32VSCodeExtension.cubeCLT.path}/STM32CubeProgrammer/bin",
            "stlinkPath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "armToolchainPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "serverArgs": ["-m", "0"]
        },
        {
            "name": "Attach (pick project) - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "attach",
            "executable": "${command:cmake.buildDirectory}/${input:cmakeProject}/src/${input:cmakeProject}-build/${input:cmakeProject}.elf",
            "servertype": "stlink",
            "device": "STM32F413RGTx",
            "interface": "swd",
            "serialNumber": "",
            "svdFile": "${config:STM32VSCodeExtension.cubeCLT.path}/STMicroelectronics_CMSIS_SVD/STM32F413.svd",
            "v1": false,
            "serverpath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${config:STM32VSCodeExtension.cubeCLT.path}/STM32CubeProgrammer/bin",
            "stlinkPath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "armToolchainPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "serverArgs": ["-m", "0"]
        },

        // ============================================================================
        //   DCM - STM32H725ZGTx. TEMPORARY: delete these two (and the "Build DCM"
        //   task) once DCM moves to the F413 - the four generic configurations
        //   above will cover it.
        // ============================================================================
        {
            "name": "Build & Debug DCM (H725) - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "launch",
            "preLaunchTask": "Build DCM",
            "executable": "${command:cmake.buildDirectory}/DCM/src/DCM-build/DCM.elf",
            "servertype": "stlink",
            "device": "STM32H725ZGTx",
            "interface": "swd",
            "serialNumber": "",
            "runToEntryPoint": "main",
            "svdFile": "${config:STM32VSCodeExtension.cubeCLT.path}/STMicroelectronics_CMSIS_SVD/STM32H725.svd",
            "v1": false,
            "serverpath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${config:STM32VSCodeExtension.cubeCLT.path}/STM32CubeProgrammer/bin",
            "stlinkPath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "armToolchainPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "serverArgs": ["-m", "0"]
        },
        {
            "name": "Attach to DCM (H725) - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "attach",
            "executable": "${command:cmake.buildDirectory}/DCM/src/DCM-build/DCM.elf",
            "servertype": "stlink",
            "device": "STM32H725ZGTx",
            "interface": "swd",
            "serialNumber": "",
            "svdFile": "${config:STM32VSCodeExtension.cubeCLT.path}/STMicroelectronics_CMSIS_SVD/STM32H725.svd",
            "v1": false,
            "serverpath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${config:STM32VSCodeExtension.cubeCLT.path}/STM32CubeProgrammer/bin",
            "stlinkPath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "armToolchainPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "serverArgs": ["-m", "0"]
        }
    ]
}
